{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run app server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm start"
    },
    {
      "name": "Launch Chrome",
      "request": "launch",
      "type": "chrome",
      "url": "http://localhost:8080/index.html",
      "webRoot": "${workspaceFolder}"
    }
  ]
}